[Unit]
Description=Delta command center
After=network-online.target
Wants=network-online.target

[Service]
User=delta
# Lets the Canvas relay read the canvas-cookie service's API token.
SupplementaryGroups=canvas-cookie
WorkingDirectory=/opt/delta
ExecStart=/opt/delta/delta-cc -addr 127.0.0.1:8080
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
